    },
    "onboarding.step3.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين الوضع الداكن والفاتح، واختر لغتك المفضلة في أي وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch seamlessly between Light and Dark themes, and enjoy full English & Arabic support."
