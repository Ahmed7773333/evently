    "onboarding.step1.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ وتابع جميع مناسباتك القادمة في مكان واحد مرتب وجميل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create, schedule, and keep track of all your upcoming moments in one beautifully organized place."
          }
        }
      }
    },
    "onboarding.step1.title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظّم فعالياتك بسهولة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize Your Events Effortlessly"
          }
        }
      }
    },
    "onboarding.step2.subtitle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميّز أهم المناسبات وابحث فيها بسرعة حسب التصنيف أو الاسم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bookmark the events that matter most and find them instantly by category or search."
          }
        }
      }
    },
    "onboarding.step2.title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ فعالياتك المفضلة"
